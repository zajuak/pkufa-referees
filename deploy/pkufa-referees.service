[Unit]
Description=PKUFA referee management website (independent local database)
After=network.target

[Service]
Type=simple
User=pkufa-referees
Group=pkufa-referees
WorkingDirectory=/opt/pkufa-referees/current
Environment=HOST=0.0.0.0
Environment=PORT=8081
Environment=STATIC_DIR=/opt/pkufa-referees/current/campus-dist
Environment=DATA_DIR=/var/lib/pkufa-referees
Environment=SEED_FILE=/var/lib/pkufa-referees/initial-copy.json
Environment=PUBLIC_QUERIES=true
EnvironmentFile=/etc/pkufa-referees.env
EnvironmentFile=-/etc/pkufa-referees-release.env
ExecStart=/opt/pkufa-referees/runtime/bin/node /opt/pkufa-referees/current/campus-server/campus.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=pkufa-referees
StateDirectoryMode=0700
UMask=0077

[Install]
WantedBy=multi-user.target
