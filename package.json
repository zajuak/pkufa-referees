{
  "name": "pkufa-referee-management",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "node --watch server/index.mjs",
    "build": "npm run build:pages",
    "start": "node server/index.mjs",
    "test": "npm run test:public",
    "db:generate": "drizzle-kit generate",
    "build:pages": "tsc -b && vite build --outDir pages-dist",
    "build:api": "node scripts/build-api.mjs",
    "test:public": "vitest run tests/calculations.test.ts tests/season-export.test.ts tests/access.test.ts tests/teams-officiating.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "playwright": "^1.64.1",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.158.0"
  }
}
